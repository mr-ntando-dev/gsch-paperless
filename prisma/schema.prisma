generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum DocumentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SiteSettings {
  id           String   @id @default("singleton")
  siteName     String   @default("MediFile")
  logoUrl      String?
  hospitalName String   @default("Gweru Specialist Children's Hospital")
  tagline      String   @default("Digital Record System")
  footerText   String   @default("© 2026 Gweru Specialist Children's Hospital")
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

model DepartmentModel {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  shortName   String
  color       String   @default("blue")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  documents   Document[]
  tasks       Task[]
  forms       Form[]
  messages    Message[]
  deptItems   DeptItem[]
  notices          DeptNotice[]
  routedFromDocs   DocumentRoute[] @relation("RoutedFrom")
  routedToDocs     DocumentRoute[] @relation("RoutedTo")
  escalatedFromTasks TaskEscalation[] @relation("EscalatedFrom")
  escalatedToTasks   TaskEscalation[] @relation("EscalatedTo")
  dutyRosters      DutyRoster[]

  @@map("departments")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String
  password       String
  role           Role             @default(STAFF)
  departmentId   String?
  department     DepartmentModel? @relation(fields: [departmentId], references: [id])
  avatar         String?
  isActive       Boolean          @default(true)
  createdByAdmin Boolean          @default(false)
  firstLogin     Boolean          @default(true)
  isRosterManager Boolean         @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  documents     Document[]     @relation("AuthoredDocuments")
  approvals     Approval[]
  tasks         Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
  notifications Notification[]
  messages      Message[]
  comments      Comment[]
  activityLogs    ActivityLog[]
  deptItems       DeptItem[]
  deptNotices     DeptNotice[]
  sentRoutes      DocumentRoute[]  @relation("SentRoutes")
  escalations     TaskEscalation[] @relation("EscalatedByUser")
  shifts          ShiftRoster[]
  dutyRosters     DutyRoster[]    @relation("RosterCreatedBy")
  dutyEntries     DutyEntry[]
  labRequests     LabRequest[]    @relation("LabRequestedBy")
  labResults      LabRequest[]    @relation("LabResultEnteredBy")
  prescriptions   Prescription[]  @relation("PrescribedBy")
  dispensedMeds   Prescription[]  @relation("DispensedBy")
  vitalsRecorded  VitalsRecord[]
}

model Document {
  id           String           @id @default(cuid())
  title        String
  content      String           @db.Text
  type         String
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  status       DocumentStatus   @default(DRAFT)
  priority     Priority         @default(MEDIUM)
  tags         String[]
  fileUrl      String?
  version      Int              @default(1)
  versionHistory Json?
  authorId     String
  author       User             @relation("AuthoredDocuments", fields: [authorId], references: [id])
  approvals    Approval[]
  comments     Comment[]
  routes       DocumentRoute[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Approval {
  id          String         @id @default(cuid())
  documentId  String
  document    Document       @relation(fields: [documentId], references: [id])
  approverId  String
  approver    User           @relation(fields: [approverId], references: [id])
  status      DocumentStatus @default(PENDING)
  comments    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Task {
  id           String           @id @default(cuid())
  title        String
  description  String?          @db.Text
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  priority     Priority         @default(MEDIUM)
  status       String           @default("TODO")
  dueDate      DateTime?
  assigneeId   String?
  assignee     User?            @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creatorId    String
  creator      User             @relation("CreatedTasks", fields: [creatorId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  escalations  TaskEscalation[]
}

model Form {
  id           String           @id @default(cuid())
  title        String
  description  String?
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  fields       Json
  isActive     Boolean          @default(true)
  submissions  FormSubmission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id])
  data        Json
  submittedBy String
  status      String   @default("SUBMITTED")
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Message {
  id           String           @id @default(cuid())
  content      String           @db.Text
  senderId     String
  sender       User             @relation(fields: [senderId], references: [id])
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  channel      String           @default("general")
  createdAt    DateTime         @default(now())
}

model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
}

model Patient {
  id            String      @id @default(cuid())
  patientId     String      @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  guardianName  String
  guardianPhone String
  address       String?
  gender        String      @default("UNKNOWN")
  bloodType     String?
  medications   Medication[]
  appointments  Appointment[]
  allergies     String?
  medicalHistory Json?
  careType      String      @default("OUTPATIENT") // ADMITTED | OBSERVATION | DAYCARE | OUTPATIENT
  isActive      Boolean     @default(true)
  admissions    Admission[]
  observations  Observation[]
  dayCareRecords DayCareRecord[]
  kitchenRequests KitchenRequest[]
  patientMessages PatientMessage[]
  invoices      Invoice[]
  vitalsRecords VitalsRecord[]
  labRequests   LabRequest[]
  prescriptions Prescription[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Admission {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  ward          String
  bed           String?
  doctor        String
  diagnosis     String?
  admitDate     DateTime  @default(now())
  dischargeDate DateTime?
  status        String    @default("ADMITTED") // ADMITTED | DISCHARGED | TRANSFERRED
  notes         String?   @db.Text
  dietaryNotes  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Observation {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id])
  reason          String
  doctor          String
  observationArea String    @default("General")
  startDate       DateTime  @default(now())
  endDate         DateTime?
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | ESCALATED
  vitals          Json?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DayCareRecord {
  id            String    @id @default(cuid())
  patientId     String?
  patient       Patient?  @relation(fields: [patientId], references: [id])
  childName     String
  age           String
  parentName    String
  parentPhone   String
  checkInTime   String
  checkOutTime  String?
  date          String
  status        String    @default("CHECKED_IN") // CHECKED_IN | CHECKED_OUT | SCHEDULED
  notes         String?
  dietaryNeeds  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model KitchenRequest {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  requestType String    @default("MEAL") // MEAL | DIETARY | SPECIAL | ALLERGY_NOTE
  mealTime    String    @default("LUNCH") // BREAKFAST | LUNCH | DINNER | SNACK
  description String    @db.Text
  dietaryNotes String?
  status      String    @default("PENDING") // PENDING | ACKNOWLEDGED | PREPARING | DELIVERED | CANCELLED
  priority    Priority  @default(MEDIUM)
  requestedBy String
  notes       String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PatientMessage {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  channel     String    @default("KITCHEN") // KITCHEN | NURSING | GENERAL
  content     String    @db.Text
  senderName  String
  senderRole  String    @default("NURSE") // NURSE | DOCTOR | ADMIN | PATIENT_GUARDIAN
  isRead      Boolean   @default(false)
  readAt      DateTime?
  replyTo     String?
  createdAt   DateTime  @default(now())
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  location    String
  priority    Priority @default(MEDIUM)
  status      String   @default("OPEN")
  requestedBy String
  assignedTo  String?
  resolvedAt  DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeptItem {
  id           String          @id @default(cuid())
  title        String
  content      String          @db.Text
  type         String
  departmentId String
  department   DepartmentModel @relation(fields: [departmentId], references: [id])
  authorId     String
  author       User            @relation(fields: [authorId], references: [id])
  isPinned     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model DeptNotice {
  id           String          @id @default(cuid())
  title        String
  body         String          @db.Text
  departmentId String
  department   DepartmentModel @relation(fields: [departmentId], references: [id])
  authorId     String
  author       User            @relation(fields: [authorId], references: [id])
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// Inter-department document routing
model DocumentRoute {
  id             String          @id @default(cuid())
  documentId     String
  document       Document        @relation(fields: [documentId], references: [id])
  fromDeptId     String
  fromDept       DepartmentModel @relation("RoutedFrom", fields: [fromDeptId], references: [id])
  toDeptId       String
  toDept         DepartmentModel @relation("RoutedTo", fields: [toDeptId], references: [id])
  sentById       String
  sentBy         User            @relation("SentRoutes", fields: [sentById], references: [id])
  note           String?
  status         String          @default("PENDING") // PENDING | ACKNOWLEDGED | ACTIONED | RETURNED
  priority       Priority        @default(MEDIUM)
  acknowledgedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@map("document_routes")
}

// Inter-department task escalation
model TaskEscalation {
  id           String          @id @default(cuid())
  taskId       String
  task         Task            @relation(fields: [taskId], references: [id])
  fromDeptId   String
  fromDept     DepartmentModel @relation("EscalatedFrom", fields: [fromDeptId], references: [id])
  toDeptId     String
  toDept       DepartmentModel @relation("EscalatedTo", fields: [toDeptId], references: [id])
  escalatedById String
  escalatedBy  User            @relation("EscalatedByUser", fields: [escalatedById], references: [id])
  reason       String
  resolved     Boolean         @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@map("task_escalations")
}

// --- Invoices / Billing ---
model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id])
  admissionId   String?
  status        String         @default("UNPAID") // UNPAID | PARTIAL | PAID | CANCELLED
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  totalAmount   Float          @default(0)
  paidAmount    Float          @default(0)
  notes         String?        @db.Text
  createdBy     String
  lineItems     InvoiceItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  total       Float
  category    String   @default("GENERAL") // WARD | DOCTOR | MEDICATION | MEAL | PROCEDURE | GENERAL
  createdAt   DateTime @default(now())
}

// --- IT Inventory ---
model InventoryAsset {
  id           String    @id @default(cuid())
  assetTag     String    @unique
  name         String
  category     String    @default("COMPUTER") // COMPUTER | PRINTER | NETWORK | MEDICAL | FURNITURE | OTHER
  brand        String?
  model        String?
  serialNumber String?
  location     String
  assignedTo   String?
  condition    String    @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR | DECOMMISSIONED
  purchaseDate DateTime?
  warrantyExpiry DateTime?
  notes        String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- Baby Clinic (persistent) ---
model BabyClinicVisit {
  id          String   @id @default(cuid())
  babyName    String
  dob         String
  parentName  String
  parentPhone String
  visitType   String   @default("IMMUNIZATION") // IMMUNIZATION | GROWTH_CHECK | SICK_VISIT | FOLLOW_UP
  weight      String?
  height      String?
  notes       String?  @db.Text
  status      String   @default("WAITING") // WAITING | IN_PROGRESS | COMPLETED | NO_SHOW
  visitDate   String
  visitTime   String
  attendedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Notifications (wire up existing model) ---
// Already exists as Notification model above — no change needed

// ===================== NEW MODELS =====================

model Medication {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  name         String
  dose         String
  route        String    @default("ORAL") // ORAL | IV | IM | TOPICAL | INHALED | RECTAL | NASAL
  frequency    String    // e.g. "8 hourly", "BD", "OD"
  startDate    DateTime  @default(now())
  endDate      DateTime?
  prescribedBy String
  status       String    @default("ACTIVE") // ACTIVE | STOPPED | COMPLETED
  notes        String?   @db.Text
  administrations MedicationAdmin[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MedicationAdmin {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id])
  givenAt      DateTime   @default(now())
  givenBy      String
  dose         String?
  notes        String?
  createdAt    DateTime   @default(now())
}

model Appointment {
  id          String    @id @default(cuid())
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id])
  patientName String?
  guardianPhone String?
  doctor      String
  department  String
  date        String
  time        String
  duration    Int       @default(30) // minutes
  type        String    @default("OUTPATIENT") // OUTPATIENT | FOLLOW_UP | PROCEDURE | CONSULTATION
  status      String    @default("SCHEDULED") // SCHEDULED | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
  reason      String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ShiftRoster {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        String
  shiftType   String    @default("DAY") // DAY | NIGHT | ON_CALL
  startTime   String
  endTime     String
  department  String
  status      String    @default("SCHEDULED") // SCHEDULED | ACTIVE | COMPLETED | ABSENT
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vaccination {
  id          String   @id @default(cuid())
  babyName    String
  dob         String
  parentName  String
  parentPhone String
  vaccine     String
  dose        String   @default("1st")
  batchNo     String?
  site        String?  // e.g. "Left thigh"
  givenBy     String
  givenDate   String
  nextDueDate String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Duty Roster (department-scoped) ───────────────────────────────────────
model DutyRoster {
  id           String          @id @default(cuid())
  title        String
  departmentId String
  department   DepartmentModel @relation(fields: [departmentId], references: [id])
  weekStart    String          // ISO date of Monday
  weekEnd      String          // ISO date of Sunday
  status       String          @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdById  String
  createdBy    User            @relation("RosterCreatedBy", fields: [createdById], references: [id])
  entries      DutyEntry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("duty_rosters")
}

model DutyEntry {
  id          String     @id @default(cuid())
  rosterId    String
  roster      DutyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  date        String     // YYYY-MM-DD
  shiftType   String     @default("DAY") // DAY | NIGHT | ON_CALL | OFF | LEAVE
  startTime   String?
  endTime     String?
  notes       String?
  createdAt   DateTime   @default(now())

  @@map("duty_entries")
}

// ─── Vitals Timeline ────────────────────────────────────────────────────────
model VitalsRecord {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  recordedById String
  recordedBy  User     @relation(fields: [recordedById], references: [id])
  temperature Float?   // °C
  pulse       Int?     // bpm
  systolic    Int?     // mmHg
  diastolic   Int?     // mmHg
  spo2        Int?     // %
  weight      Float?   // kg
  height      Float?   // cm
  respRate    Int?     // breaths/min
  glucoseLevel Float?  // mmol/L
  notes       String?  @db.Text
  recordedAt  DateTime @default(now())

  @@map("vitals_records")
}

// ─── Lab & Radiology Requests ───────────────────────────────────────────────
model LabRequest {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  requestedById String
  requestedBy   User     @relation("LabRequestedBy", fields: [requestedById], references: [id])
  type          String   // LABORATORY | RADIOLOGY
  testName      String
  urgency       String   @default("ROUTINE") // ROUTINE | URGENT | STAT
  clinicalNotes String?  @db.Text
  status        String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  result        String?  @db.Text
  resultFileUrl String?
  resultEnteredById String?
  resultEnteredBy   User?   @relation("LabResultEnteredBy", fields: [resultEnteredById], references: [id])
  resultEnteredAt   DateTime?
  requestedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("lab_requests")
}

// ─── Pharmacy ───────────────────────────────────────────────────────────────
model PharmacyItem {
  id            String         @id @default(cuid())
  name          String
  genericName   String?
  category      String         @default("MEDICATION") // MEDICATION | SUPPLY | CONSUMABLE
  unit          String         @default("tablet") // tablet, vial, bottle, box, etc.
  stockLevel    Int            @default(0)
  reorderLevel  Int            @default(10)
  expiryDate    String?
  batchNumber   String?
  supplier      String?
  unitCost      Float?
  isActive      Boolean        @default(true)
  prescriptions Prescription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("pharmacy_items")
}

model Prescription {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id])
  pharmacyItemId  String
  pharmacyItem    PharmacyItem  @relation(fields: [pharmacyItemId], references: [id])
  prescribedById  String
  prescribedBy    User          @relation("PrescribedBy", fields: [prescribedById], references: [id])
  dosage          String        // e.g. "500mg"
  frequency       String        // e.g. "8 hourly"
  duration        String        // e.g. "5 days"
  route           String        @default("ORAL") // ORAL | IV | IM | TOPICAL | OTHER
  quantity        Int
  status          String        @default("PENDING") // PENDING | DISPENSED | CANCELLED
  dispensedById   String?
  dispensedBy     User?         @relation("DispensedBy", fields: [dispensedById], references: [id])
  dispensedAt     DateTime?
  notes           String?       @db.Text
  allergyChecked  Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("prescriptions")
}

// ─── Bed Management ─────────────────────────────────────────────────────────
model Bed {
  id           String   @id @default(cuid())
  bedNumber    String
  wardName     String
  departmentId String?
  status       String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | MAINTENANCE | RESERVED
  patientId    String?  @unique
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([bedNumber, wardName])
  @@map("beds")
}

