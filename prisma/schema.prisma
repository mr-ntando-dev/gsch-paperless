generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum DocumentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model DepartmentModel {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  shortName   String
  color       String   @default("blue")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  documents   Document[]
  tasks       Task[]
  forms       Form[]
  messages    Message[]
  deptItems   DeptItem[]
  notices          DeptNotice[]
  routedFromDocs   DocumentRoute[] @relation("RoutedFrom")
  routedToDocs     DocumentRoute[] @relation("RoutedTo")
  escalatedFromTasks TaskEscalation[] @relation("EscalatedFrom")
  escalatedToTasks   TaskEscalation[] @relation("EscalatedTo")

  @@map("departments")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String
  password       String
  role           Role             @default(STAFF)
  departmentId   String?
  department     DepartmentModel? @relation(fields: [departmentId], references: [id])
  avatar         String?
  isActive       Boolean          @default(true)
  createdByAdmin Boolean          @default(false)
  firstLogin     Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  documents     Document[]     @relation("AuthoredDocuments")
  approvals     Approval[]
  tasks         Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
  notifications Notification[]
  messages      Message[]
  comments      Comment[]
  activityLogs    ActivityLog[]
  deptItems       DeptItem[]
  deptNotices     DeptNotice[]
  sentRoutes      DocumentRoute[]  @relation("SentRoutes")
  escalations     TaskEscalation[] @relation("EscalatedByUser")
}

model Document {
  id           String           @id @default(cuid())
  title        String
  content      String           @db.Text
  type         String
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  status       DocumentStatus   @default(DRAFT)
  priority     Priority         @default(MEDIUM)
  tags         String[]
  fileUrl      String?
  version      Int              @default(1)
  versionHistory Json?
  authorId     String
  author       User             @relation("AuthoredDocuments", fields: [authorId], references: [id])
  approvals    Approval[]
  comments     Comment[]
  routes       DocumentRoute[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Approval {
  id          String         @id @default(cuid())
  documentId  String
  document    Document       @relation(fields: [documentId], references: [id])
  approverId  String
  approver    User           @relation(fields: [approverId], references: [id])
  status      DocumentStatus @default(PENDING)
  comments    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Task {
  id           String           @id @default(cuid())
  title        String
  description  String?          @db.Text
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  priority     Priority         @default(MEDIUM)
  status       String           @default("TODO")
  dueDate      DateTime?
  assigneeId   String?
  assignee     User?            @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creatorId    String
  creator      User             @relation("CreatedTasks", fields: [creatorId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  escalations  TaskEscalation[]
}

model Form {
  id           String           @id @default(cuid())
  title        String
  description  String?
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  fields       Json
  isActive     Boolean          @default(true)
  submissions  FormSubmission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id])
  data        Json
  submittedBy String
  status      String   @default("SUBMITTED")
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Message {
  id           String           @id @default(cuid())
  content      String           @db.Text
  senderId     String
  sender       User             @relation(fields: [senderId], references: [id])
  departmentId String?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  channel      String           @default("general")
  createdAt    DateTime         @default(now())
}

model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
}

model Patient {
  id            String      @id @default(cuid())
  patientId     String      @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  guardianName  String
  guardianPhone String
  address       String?
  gender        String      @default("UNKNOWN")
  bloodType     String?
  allergies     String?
  medicalHistory Json?
  careType      String      @default("OUTPATIENT") // ADMITTED | OBSERVATION | DAYCARE | OUTPATIENT
  isActive      Boolean     @default(true)
  admissions    Admission[]
  observations  Observation[]
  dayCareRecords DayCareRecord[]
  kitchenRequests KitchenRequest[]
  patientMessages PatientMessage[]
  invoices      Invoice[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Admission {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  ward          String
  bed           String?
  doctor        String
  diagnosis     String?
  admitDate     DateTime  @default(now())
  dischargeDate DateTime?
  status        String    @default("ADMITTED") // ADMITTED | DISCHARGED | TRANSFERRED
  notes         String?   @db.Text
  dietaryNotes  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Observation {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id])
  reason          String
  doctor          String
  observationArea String    @default("General")
  startDate       DateTime  @default(now())
  endDate         DateTime?
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | ESCALATED
  vitals          Json?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DayCareRecord {
  id            String    @id @default(cuid())
  patientId     String?
  patient       Patient?  @relation(fields: [patientId], references: [id])
  childName     String
  age           String
  parentName    String
  parentPhone   String
  checkInTime   String
  checkOutTime  String?
  date          String
  status        String    @default("CHECKED_IN") // CHECKED_IN | CHECKED_OUT | SCHEDULED
  notes         String?
  dietaryNeeds  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model KitchenRequest {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  requestType String    @default("MEAL") // MEAL | DIETARY | SPECIAL | ALLERGY_NOTE
  mealTime    String    @default("LUNCH") // BREAKFAST | LUNCH | DINNER | SNACK
  description String    @db.Text
  dietaryNotes String?
  status      String    @default("PENDING") // PENDING | ACKNOWLEDGED | PREPARING | DELIVERED | CANCELLED
  priority    Priority  @default(MEDIUM)
  requestedBy String
  notes       String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PatientMessage {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  channel     String    @default("KITCHEN") // KITCHEN | NURSING | GENERAL
  content     String    @db.Text
  senderName  String
  senderRole  String    @default("NURSE") // NURSE | DOCTOR | ADMIN | PATIENT_GUARDIAN
  isRead      Boolean   @default(false)
  readAt      DateTime?
  replyTo     String?
  createdAt   DateTime  @default(now())
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  location    String
  priority    Priority @default(MEDIUM)
  status      String   @default("OPEN")
  requestedBy String
  assignedTo  String?
  resolvedAt  DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeptItem {
  id           String          @id @default(cuid())
  title        String
  content      String          @db.Text
  type         String
  departmentId String
  department   DepartmentModel @relation(fields: [departmentId], references: [id])
  authorId     String
  author       User            @relation(fields: [authorId], references: [id])
  isPinned     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model DeptNotice {
  id           String          @id @default(cuid())
  title        String
  body         String          @db.Text
  departmentId String
  department   DepartmentModel @relation(fields: [departmentId], references: [id])
  authorId     String
  author       User            @relation(fields: [authorId], references: [id])
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// Inter-department document routing
model DocumentRoute {
  id             String          @id @default(cuid())
  documentId     String
  document       Document        @relation(fields: [documentId], references: [id])
  fromDeptId     String
  fromDept       DepartmentModel @relation("RoutedFrom", fields: [fromDeptId], references: [id])
  toDeptId       String
  toDept         DepartmentModel @relation("RoutedTo", fields: [toDeptId], references: [id])
  sentById       String
  sentBy         User            @relation("SentRoutes", fields: [sentById], references: [id])
  note           String?
  status         String          @default("PENDING") // PENDING | ACKNOWLEDGED | ACTIONED | RETURNED
  priority       Priority        @default(MEDIUM)
  acknowledgedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@map("document_routes")
}

// Inter-department task escalation
model TaskEscalation {
  id           String          @id @default(cuid())
  taskId       String
  task         Task            @relation(fields: [taskId], references: [id])
  fromDeptId   String
  fromDept     DepartmentModel @relation("EscalatedFrom", fields: [fromDeptId], references: [id])
  toDeptId     String
  toDept       DepartmentModel @relation("EscalatedTo", fields: [toDeptId], references: [id])
  escalatedById String
  escalatedBy  User            @relation("EscalatedByUser", fields: [escalatedById], references: [id])
  reason       String
  resolved     Boolean         @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@map("task_escalations")
}

// --- Invoices / Billing ---
model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id])
  admissionId   String?
  status        String         @default("UNPAID") // UNPAID | PARTIAL | PAID | CANCELLED
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  totalAmount   Float          @default(0)
  paidAmount    Float          @default(0)
  notes         String?        @db.Text
  createdBy     String
  lineItems     InvoiceItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  total       Float
  category    String   @default("GENERAL") // WARD | DOCTOR | MEDICATION | MEAL | PROCEDURE | GENERAL
  createdAt   DateTime @default(now())
}

// --- IT Inventory ---
model InventoryAsset {
  id           String    @id @default(cuid())
  assetTag     String    @unique
  name         String
  category     String    @default("COMPUTER") // COMPUTER | PRINTER | NETWORK | MEDICAL | FURNITURE | OTHER
  brand        String?
  model        String?
  serialNumber String?
  location     String
  assignedTo   String?
  condition    String    @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR | DECOMMISSIONED
  purchaseDate DateTime?
  warrantyExpiry DateTime?
  notes        String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- Baby Clinic (persistent) ---
model BabyClinicVisit {
  id          String   @id @default(cuid())
  babyName    String
  dob         String
  parentName  String
  parentPhone String
  visitType   String   @default("IMMUNIZATION") // IMMUNIZATION | GROWTH_CHECK | SICK_VISIT | FOLLOW_UP
  weight      String?
  height      String?
  notes       String?  @db.Text
  status      String   @default("WAITING") // WAITING | IN_PROGRESS | COMPLETED | NO_SHOW
  visitDate   String
  visitTime   String
  attendedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Notifications (wire up existing model) ---
// Already exists as Notification model above — no change needed

